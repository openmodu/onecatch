---
// The hero's proof: the application's own normalized event stream, typed out
// rather than shown as a still. Two runtimes on one timeline, a sandbox level
// per step, and a closing signal sending the loop back to its first step.
//
// The event kinds are the real ones from internal/usecase/agentrun/event.go —
// if that list changes, this should follow.
const LINES = [
  ["started", "codex · thread 019f4b11", "workspace-write"],
  ["reasoning", "先读现有的中断实现，再补上缺的状态反馈", ""],
  ["tool_use", 'rg "ResumeSessionID" internal/', ""],
  ["tool_result", "4 matches", ""],
  ["file_change", "M internal/usecase/execution/worker.go", ""],
  ["usage", "in 18.2k · out 1.4k", ""],
  ["result", "succeeded · 42s", ""],
  ["divider", "", ""],
  ["started", "claude · session 45db32aa", "read-only"],
  ["reasoning", "检查恢复路径会不会重复追加同一批事件", ""],
  ["tool_use", "go test ./internal/usecase/...", ""],
  ["tool_result", "ok  6 packages", ""],
  ["result-warn", "needs_work → 回到「实现」", ""],
];
---

<div class="band">
  <div class="terminal">
    <div class="terminal-bar">
      <span class="light" aria-hidden="true"></span>
      <span class="light" aria-hidden="true"></span>
      <span class="light" aria-hidden="true"></span>
      <span class="terminal-title">个人工作台 / 实现 → 审查 loop</span>
    </div>
    <div class="terminal-body">
      {/* Server-rendered in full, so the transcript is real content for a
          reader without JavaScript and for anything reading the page. The
          script below only replays it. */}
      <pre class="stream" id="stream" aria-label="一次运行的事件流示例">{LINES.map(([kind, text, tail]) => (
        kind === "divider"
          ? <span class="row"><span class="divider">{"─".repeat(44)}</span></span>
          : <span class="row">
              <span class:list={["kind", kind]}>{kind === "result-warn" ? "result" : kind}</span>
              <span class="text">{tail ? `${text}    ${tail}` : text}</span>
            </span>
      ))}</pre>
    </div>
  </div>
</div>

<script>
  // Replays the server-rendered transcript once it scrolls into view. Reduced
  // motion, or no IntersectionObserver, simply leaves the rendered stream be.
  const stream = document.getElementById("stream");
  if (stream && !window.matchMedia("(prefers-reduced-motion: reduce)").matches && typeof IntersectionObserver === "function") {
    const rows = Array.from(stream.children);
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.disconnect();
        stream.replaceChildren();
        const caret = document.createElement("span");
        caret.className = "caret blink";
        stream.appendChild(caret);
        let index = 0;
        const step = () => {
          if (index >= rows.length) {
            caret.remove();
            return;
          }
          const row = rows[index];
          stream.insertBefore(row, caret);
          index += 1;
          window.setTimeout(step, row.querySelector(".divider") ? 190 : 320);
        };
        window.setTimeout(step, 340);
      }
    }, { threshold: 0.35 });
    observer.observe(stream);
  }
</script>
