---
// A titled section. The eyebrow carries the tick that hangs on the page's
// spine, so every section marked this way lands on the same rail.
interface Props {
  id: string;
  eyebrow: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<section class="section" id={id}>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  <slot />
</section>
