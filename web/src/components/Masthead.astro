---
// Site chrome, in the layout so every page inherits it. Nav entries that point
// at sections only exist on the home page, so they are absolute from the root.
const links = [
  { href: "/#build", label: "构建" },
  { href: "/#questions", label: "问题" },
  { href: "https://github.com/openmodu/onecatch", label: "GitHub" },
];
---

<header class="masthead">
  <a class="mark" href="/"><span class="glyph" aria-hidden="true">1</span>OneCatch<span class="tagline">One place, catch everything</span></a>
  <nav class="masthead-links">
    {links.map(({ href, label }) => <a href={href}>{label}</a>)}
    <button class="theme-toggle" type="button" id="theme-toggle" aria-label="切换深浅色">
      <svg class="moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      <svg class="sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </button>
  </nav>
</header>
