<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openmodu.oneshot-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/oneshot-worker</string>
    <string>--listen</string>
    <string>0.0.0.0:9231</string>
    <string>--id</string>
    <string>mac-mini</string>
    <string>--name</string>
    <string>Build Mac mini</string>
    <string>--workspace</string>
    <string>workspace-id=/Users/worker/Code/project</string>
    <string>--tls-cert</string>
    <string>/Users/worker/.config/oneshot-worker/server.pem</string>
    <string>--tls-key</string>
    <string>/Users/worker/.config/oneshot-worker/server-key.pem</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ONESHOT_WORKER_TOKEN</key>
    <string>replace-with-a-random-token</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/worker/Library/Logs/oneshot-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/worker/Library/Logs/oneshot-worker.log</string>
</dict>
</plist>
