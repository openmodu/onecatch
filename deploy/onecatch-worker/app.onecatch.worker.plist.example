<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.onecatch.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/onecatch-worker</string>
    <string>--listen</string>
    <string>0.0.0.0:9231</string>
    <string>--id</string>
    <string>mac-mini</string>
    <string>--name</string>
    <string>Build Mac mini</string>
    <string>--data-dir</string>
    <string>/Users/worker/.onecatch-worker</string>
    <string>--tls-cert</string>
    <string>/Users/worker/.config/onecatch-worker/server.pem</string>
    <string>--tls-key</string>
    <string>/Users/worker/.config/onecatch-worker/server-key.pem</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/worker/Library/Logs/onecatch-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/worker/Library/Logs/onecatch-worker.log</string>
</dict>
</plist>
