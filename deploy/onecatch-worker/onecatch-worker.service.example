[Unit]
Description=OneCatch remote agent worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=onecatch
Group=onecatch
ExecStart=/usr/local/bin/onecatch-worker \
  --listen 0.0.0.0:9231 \
  --id linux-builder \
  --name "Linux builder" \
  --data-dir /var/lib/onecatch-worker \
  --tls-cert /etc/onecatch-worker/server.pem \
  --tls-key /etc/onecatch-worker/server-key.pem
StateDirectory=onecatch-worker
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5s
TimeoutStopSec=35s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
